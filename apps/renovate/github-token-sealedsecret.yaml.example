# VORLAGE -- nicht anwenden. Das echte SealedSecret erzeugst du mit kubeseal,
# siehe README.md. Nur das Ergebnis darf nach github-token-sealedsecret.yaml
# committet werden; das rohe Token niemals.
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: renovate-github-token
  namespace: renovate
spec:
  encryptedData:
    RENOVATE_TOKEN: <AgB...-Blob von kubeseal>
  template:
    metadata:
      name: renovate-github-token
      namespace: renovate
    type: Opaque
