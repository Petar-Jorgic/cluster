# VORLAGE -- nicht anwenden. Das echte SealedSecret erzeugst du mit kubeseal,
# siehe README.md. Nur das Ergebnis darf nach gotify-sealedsecret.yaml
# committet werden; das rohe Token niemals.
#
# SealedSecrets sind auf Name UND Namespace versiegelt. Der Token aus
# cluster-cleanup-gotify laesst sich also nicht wiederverwenden, auch wenn es
# derselbe Gotify-App-Token waere -- er muss fuer namespace: renovate neu
# versiegelt werden.
apiVersion: bitnami.com/v1alpha1
kind: SealedSecret
metadata:
  name: renovate-gotify
  namespace: renovate
spec:
  encryptedData:
    GOTIFY_TOKEN: <AgB...-Blob von kubeseal>
  template:
    metadata:
      name: renovate-gotify
      namespace: renovate
    type: Opaque
